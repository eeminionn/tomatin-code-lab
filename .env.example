VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional. Include the leading and trailing slash.
VITE_BASE_PATH=/tomatin-code-lab/
# Forces the static contribution sandbox and ignores Supabase credentials.
VITE_FRONTEND_ONLY=false

# Edge Function secrets. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are
# supplied automatically by Supabase.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
ALLOWED_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io
# Supabase Edge secret. In GitHub Actions, store this value as
# SUBMISSION_REPOSITORY_TOKEN because GitHub reserves the GITHUB_ prefix.
GITHUB_REPOSITORY_TOKEN=github_pat_REPLACE_ME
GITHUB_REPOSITORY_OWNER=YOUR_GITHUB_USERNAME
GITHUB_REPOSITORY_NAME=YOUR_PRIVATE_SUBMISSIONS_REPOSITORY
# Dedicated token for assignment mentions. Select only the public application
# repository and grant Issues: Read and write plus Metadata: Read-only.
GITHUB_NOTIFICATION_TOKEN=github_pat_REPLACE_ME
GITHUB_NOTIFICATION_OWNER=YOUR_GITHUB_USERNAME
GITHUB_NOTIFICATION_REPOSITORY=tomatin-code-lab
GITHUB_NOTIFICATION_ISSUE_NUMBER=59
